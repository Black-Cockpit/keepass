# --------------------------------------------------------------------------------------------------
# Local / Ephemeral
# --------------------------------------------------------------------------------------------------

# Ignore files and directories prefixed with local_
**/local_**

# Ignore files with the .local extension
**/*.local

# --------------------------------------------------------------------------------------------------
# Secrets
# --------------------------------------------------------------------------------------------------

# Ignore KeePass databases wherever they appear
**/*.kdbx

# Ignore credential variable files
credentials.yml

# Ignore environment files that may carry credentials
.env

# --------------------------------------------------------------------------------------------------
# Build products
# --------------------------------------------------------------------------------------------------

# Ignore Python bytecode
*.py[co]

# Ignore build output and archives
build
dist
AUTHORS.TXT
**/*.gz

# Ignore RPM build products
MANIFEST
rpm-build

# Ignore the release directory
packaging/release/ansible_release

# --------------------------------------------------------------------------------------------------
# Ansible
# --------------------------------------------------------------------------------------------------

# Ignore local inventories
**/*.ini

# Ignore retry files and command output produced by playbook runs
*.retry
*.out

# Ignore ansible-test and changelog caches
/SYMLINK_CACHE.json
changelogs/.plugin-cache.yaml
.ansible-test-timeout.json

# Ignore Ansible package metadata (stable-2.9, 2.10 and 2.11 layouts)
/lib/ansible.egg-info/
/lib/ansible_base.egg-info/
/lib/ansible_core.egg-info/

# Ignore the vendored library directory, keeping its package marker
lib/ansible/_vendor/*
!lib/ansible/_vendor/__init__.py

# --------------------------------------------------------------------------------------------------
# Documentation build
# --------------------------------------------------------------------------------------------------

# Ignore generated man pages
docs/man/man1/ansible*.1
docs/man/man1/ansible*.1.asciidoc.in
docs/man/man3/*

# Ignore generated docsite content
docs/docsite/_build
docs/docsite/*.html
docs/docsite/htmlout
docs/docsite/rst/conf.py
docs/docsite/rst/index.rst
docs/docsite/rst/cli/ansible-*.rst
docs/docsite/rst/cli/ansible.rst
docs/docsite/rst/dev_guide/collections_galaxy_meta.rst
docs/docsite/rst/dev_guide/testing/sanity/index.rst.new
docs/docsite/rst/dev_guide/index.rst
docs/docsite/rst/modules/*.rst
docs/docsite/rst/collections/*.rst
!docs/docsite/rst/collections/all_plugins.rst
docs/docsite/rst/collections/*/*.rst
docs/docsite/rst/playbooks_directives.rst
docs/docsite/rst/plugins_by_category.rst
docs/docsite/rst/plugins/*/*.rst
docs/docsite/rst/reference_appendices/config.rst
docs/docsite/rst/reference_appendices/playbooks_keywords.rst
docs/docsite/rst_warnings
docs/docsite/searchindex.js
docs/docsite/_static/*.gif
docs/docsite/_static/*.png
docs/docsite/_static/websupport.js

# --------------------------------------------------------------------------------------------------
# Tests
# --------------------------------------------------------------------------------------------------

# Ignore test caches
.pytest_cache/
.pytest_cache
.tox
.cache
/.cache/
/test/cache/*

# Ignore test and coverage reports
results.xml
coverage.xml
htmlcov/
.coverage
/test/units/cover-html
test/units/.coverage.*
/test/results/

# Ignore the development test directory
/test/develop

# Ignore integration test inventories, backups and cloud configurations
/test/integration/inventory
/test/integration/inventory.networking
/test/integration/inventory.winrm
/test/integration/targets/*/backup/
/test/integration/cloud-config-*.*
!/test/integration/cloud-config-*.*.template
/test/integration/cloud-config-aws.yml
/test/integration/cloud-config-azure.yml
/test/integration/cloud-config-cs.ini

# --------------------------------------------------------------------------------------------------
# Python
# --------------------------------------------------------------------------------------------------

# Ignore Python virtual environments in any folder
**/*venv
.venv
venv/
venv
env/
env
ENV/
env.bak/
venv.bak/

# Ignore the local Python version selector
.python-version

# Ignore rope project data
.ropeproject

# --------------------------------------------------------------------------------------------------
# Vagrant
# --------------------------------------------------------------------------------------------------

# Ignore local Vagrant environments
Vagrantfile
.vagrant

# --------------------------------------------------------------------------------------------------
# OS junk
# --------------------------------------------------------------------------------------------------

# Ignore macOS folder metadata
.DS_Store

# --------------------------------------------------------------------------------------------------
# IDE
# --------------------------------------------------------------------------------------------------

# Ignore Visual Studio Code workspace settings
.vscode/

# Ignore JetBrains IDE project directories and module files
.idea
*.iml

# Ignore Eclipse and PyDev project files
.project
.pydevproject

# Ignore Sublime Text project files
*.sublime-project
*.sublime-workspace

# Ignore Emacs backup and autosave files
*~
.\#*
\#*

# Ignore Vim swap and undo files
*.swp
*.swo
[._]*.un~

# Ignore local ack configuration files
.ackrc
